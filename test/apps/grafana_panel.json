      "query": "from(bucket: \"dunedaq\")\n    |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n    |> filter(fn: (r) => r._measurement == \"datafilter_adc_histogram\" and r._field == \"count\")\n    |> filter(fn: (r) => r.app == \"DataFilter_0\")\n    |> group(columns: [\"bin\", \"outcome\"])\n    |> sum()\n    |> group()\n    |> map(fn: (r) => ({ r with bin_num: int(v: r.bin) }))\n    |> drop(columns: [\"_start\", \"_stop\", \"bin\"])\n    |> pivot(rowKey: [\"bin_num\"], columnKey: [\"outcome\"], valueColumn: \"_value\")\n    |> sort(columns: [\"bin_num\"])",
